# Local development: copy this file to .env and fill in real values.
# Production: set the same names in the Vercel project
# (Settings → Environment Variables). Do not commit .env.

# Neon Postgres. Use the pooled URL at runtime and the direct URL for Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Cloudinary. Used by the admin media upload routes.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Long random string. Signs the admin session cookie.
SESSION_SECRET=""

# Public site origin, no trailing slash. Used by SEO, robots, and sitemap.
APP_URL="https://your-project.vercel.app"

# Inbox for quote requests (Google Workspace / business mailbox).
CONTACT_EMAIL="info@yearwiseservices.com"

# Resend "from" address. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Yearwise Services <info@yearwiseservices.com>"

# Resend. Quote emails are skipped when this is empty.
RESEND_API_KEY=""

# Cloudflare Turnstile. Protects the contact form from junk leads.
# Required in production (APP_URL not localhost). Local/dev skips when empty.
# Create keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Local always-pass test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
